<Window x:Class="FamilyTime.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Family Time" Width="1080" Height="780" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico" Closing="OnClosing">
  <Grid Margin="30,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PauseButton" Content="Пауза" Click="PauseClick"/>
        <Button Content="Настройки" Click="SettingsClick" Margin="0"/>
      </StackPanel>
      <StackPanel><TextBlock Text="Family Time" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="ProfileText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#EAF0FC" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
      <DockPanel><TextBlock x:Name="LiveStatus" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel>
    </Border>
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
      <TabItem Header="Сегодня" Padding="18,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,18,0,4">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Учтено сегодня" Style="{StaticResource Label}"/><TextBlock x:Name="ActiveText" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Основное время за компьютером" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="BudgetLabel" Text="Осталось на сегодня" Style="{StaticResource Label}"/><TextBlock x:Name="BudgetText" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="LimitText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
              <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Видео в фоне" Style="{StaticResource Label}"/><TextBlock x:Name="BackgroundText" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Отдельно от основного времени" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
            </Grid>
            <ProgressBar x:Name="LimitProgress" Height="6" Margin="0,14,0,8" Maximum="100" Foreground="{StaticResource Accent}" Background="#E2E8F2" BorderThickness="0"/>
            <TextBlock x:Name="QualityText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,14"><TextBlock Text="Приложения и сайты" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Время" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel>
                <TextBlock x:Name="EmptyText" Text="Здесь появятся приложения и сайты после начала учёта." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,20"/>
                <ItemsControl x:Name="TodayActivities"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Duration}" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="На что ушло время" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <ItemsControl x:Name="TodayCategories"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><DockPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Duration}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel><ProgressBar Value="{Binding Percent}" Maximum="100" Height="5" Margin="0,8,0,0" Foreground="#5A82DA" Background="#EDF1F8" BorderThickness="0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock x:Name="RestText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,18,0,0"/>
              </StackPanel></Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,4"><Button Content="Отправить отчёт в Telegram" Style="{StaticResource Primary}" Click="SendClick"/><Button Content="Скопировать отчёт" Click="CopyClick"/></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="История" Padding="18,10">
        <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal"><TextBlock Text="С" VerticalAlignment="Center" Margin="0,0,10,0"/><DatePicker x:Name="FromDate" Width="150"/><TextBlock Text="по" VerticalAlignment="Center" Margin="12,0"/><DatePicker x:Name="ToDate" Width="150"/><Button Content="Показать" Click="HistoryClick" Margin="14,0,0,0"/></StackPanel>
          <TextBlock Grid.Row="1" x:Name="HistorySummary" TextWrapping="Wrap" FontSize="19" Margin="0,20"/>
          <DataGrid Grid.Row="2" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F8" RowHeight="42" Background="White" BorderBrush="#E5EAF2"><DataGrid.Columns><DataGridTextColumn Header="Приложение / сайт" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="180"/><DataGridTextColumn Header="Учтено" Binding="{Binding Duration}" Width="150"/></DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Категории" Padding="18,10">
        <StackPanel Margin="0,20,0,0"><TextBlock Text="Уточните, к какой категории относится приложение или сайт." FontSize="18"/><TextBlock Text="Правило применяется к новым интервалам. Сохранённая история остаётся в прежних категориях." Foreground="{StaticResource Muted}" Margin="0,8,0,20" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal"><ComboBox x:Name="RuleKind" Width="150" SelectedIndex="0"><ComboBoxItem Content="Приложение"/><ComboBoxItem Content="Сайт"/></ComboBox><TextBox x:Name="RuleKey" Width="260" Margin="12,0" ToolTip="Имя процесса без .exe, например minecraft, или домен, например school.ru"/><ComboBox x:Name="RuleCategory" Width="150"/><Button Content="Сохранить правило" Click="SaveRuleClick" Margin="12,0,0,0"/></StackPanel>
          <TextBlock Text="Для приложения: имя процесса без .exe. Для сайта: только домен, например school.ru." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,16"/>
          <DataGrid x:Name="RulesGrid" Height="280" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="White" RowHeight="40" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Правило" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="Категория" Binding="{Binding Value}" Width="200"/></DataGrid.Columns></DataGrid>
          <Button Content="Удалить выбранное правило" Click="DeleteRuleClick" HorizontalAlignment="Left" Margin="0,14,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="О проекте" Padding="18,10">
        <StackPanel Margin="0,24,0,0" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Больше понимания. Меньше догадок." FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Family Time показывает учтённое время в приложениях, играх и браузере. Дневной лимит напоминает о договорённости: учёт продолжается и после его достижения." TextWrapping="Wrap" Margin="0,18" FontSize="16"/>
          <TextBlock Text="История хранится на этом компьютере. В Telegram уходят только отчёты вашему боту. Приложение не записывает переписку, нажатия клавиш и содержимое экрана." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
          <TextBlock Text="Если компьютер выключен, спит или приложение закрыто, запрос Telegram не получит немедленного ответа. Состояние «простой» — оценка по отсутствию ввода; просмотр видео и игры с контроллером требуют проверки на вашем компьютере." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,22"/>
          <StackPanel Orientation="Horizontal"><Button x:Name="SupportButton" Content="Поддержать разработку" Style="{StaticResource Primary}" Click="SupportClick" Visibility="Collapsed"/><Button x:Name="RepositoryButton" Content="Исходники на GitHub" Click="RepositoryClick" Visibility="Collapsed"/><Button Content="Открыть инструкцию" Click="DocsClick"/></StackPanel>
          <TextBlock Text="Версия 0.1.0 • предварительная сборка • Windows 11 x64" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,26,0,0"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock x:Name="FeedbackText" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="Закрытие окна оставляет учёт в области уведомлений" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel>
  </Grid>
</Window>
