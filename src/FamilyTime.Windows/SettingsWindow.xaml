<Window x:Class="FamilyTime.Windows.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FamilyTime.Windows" Title="Настройки — Family Time"
 Width="850" Height="760" MinWidth="780" MinHeight="570" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="Heading" Text="Настройки семьи" FontSize="25" FontWeight="SemiBold"/>
        <local:HelpTip Text="Все настройки можно менять позже. Задайте имя и лимит, нажмите «Сохранить и начать учёт». Telegram и браузер подключаются отдельно. После сохранения окно остаётся открытым. Закройте его, закончив настройку."/>
      </StackPanel>
      <TextBlock x:Name="AccountText" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
      <TabItem Header="Учёт и лимит" Padding="10,9"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,14,0">
        <Border Background="#EAF0FC" CornerRadius="10" Padding="14"><TextBlock Text="Telegram не обязателен для начала работы. Сохраните настройки — учёт начнётся, а это окно останется открытым." TextWrapping="Wrap"/></Border>
        <local:HelpLabel Label="Имя ребёнка в отчётах" Help="Например, Мирон. Это название профиля для ваших отчётов. Регистрация и электронная почта не нужны."/>
        <TextBox x:Name="ProfileBox" MaxLength="60"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><CheckBox x:Name="AutoStartBox" Content="Запускать при входе в Windows"/><local:HelpTip Text="Запуск в той учётной записи, где установлена программа. Окно не мешает работе: значок находится возле часов. Если выключить эту настройку, учёт начинается только после ручного запуска."/></StackPanel>
        <StackPanel Orientation="Horizontal"><CheckBox x:Name="LimitEnabledBox" Content="Включить дневной лимит"/><local:HelpTip Text="Суммирует активное время за весь день, даже после перезагрузки. При достижении лимита уведомляет ребёнка, а после подключения бота — родителя. Компьютер не блокируется; превышение учитывается."/></StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><local:HelpLabel Label="Лимит, минут в день" Help="120 минут = 2 часа. Сон, блокировка и определённый программой простой не расходуют лимит. Сайты входят во время браузера и не считаются второй раз."/><TextBox x:Name="LimitBox"/></StackPanel>
          <StackPanel Grid.Column="2"><local:HelpLabel Label="Предупредить за, минут" Help="10 — предупреждение за 10 минут до лимита. 0 выключает предварительное предупреждение. Значение должно быть меньше дневного лимита."/><TextBox x:Name="WarningBox"/></StackPanel>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><local:HelpLabel Label="Простой после, минут" Help="После этого времени без клавиатуры, мыши или поддерживаемого контроллера программа предполагает, что ребёнок отошёл. YouTube на переднем плане с расширением учитывается и без движения мыши."/><TextBox x:Name="IdleBox"/></StackPanel>
          <StackPanel Grid.Column="2"><local:HelpLabel Label="Конец сеанса, минут" Help="Например, 15: после 15 минут без учитываемой активности сеанс завершается и можно отправить отчёт о нём. Дневной лимит при этом не обнуляется."/><TextBox x:Name="SessionBox"/></StackPanel>
        </Grid>
        <TextBlock x:Name="ZoneText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,12" TextWrapping="Wrap"/>
        <WrapPanel><Button Content="Проверить уведомление Windows" Click="TestNoticeClick"/><local:HelpTip Text="Показывает пробное уведомление. В игре или режиме «Не беспокоить» Windows может скрывать баннер. Остаток времени всегда доступен на экране «Сегодня»."/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Защита" Padding="10,9"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,14,0">
        <local:HelpLabel Label="Родительский пароль" Help="Защищает настройки, категории, паузу и полный выход через приложение, а также штатное обновление и удаление. Статистика доступна ребёнку. Пароль хранится как солёный хеш, не открытым текстом."/>
        <TextBlock x:Name="ProtectionStatus" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,16"/>
        <local:HelpLabel Label="Новый пароль" Help="От 8 до 128 символов. Используйте пароль, которого ребёнок не знает. Сохраните его в менеджере паролей: сброса через Telegram нет."/>
        <PasswordBox x:Name="NewParentPassword" MaxLength="128"/>
        <local:HelpLabel Label="Повторите пароль" Help="Введите тот же пароль второй раз, чтобы исключить опечатку. Поля очищаются после успешного сохранения."/>
        <PasswordBox x:Name="RepeatParentPassword" MaxLength="128"/>
        <WrapPanel Margin="0,18,0,14"><Button Content="Установить / изменить пароль" Click="SetPasswordClick" Style="{StaticResource Primary}"/><Button x:Name="RemovePasswordButton" Content="Убрать пароль" Click="RemovePasswordClick"/></WrapPanel>
        <Border Background="#FFF3DB" Padding="16" CornerRadius="10"><StackPanel>
          <TextBlock Text="Границы защиты" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Крестик скрывает окно, но не выключает учёт. Полный выход и пауза требуют пароль. Закончив настройку, закройте окно настроек: пока оно открыто, доступ родителя сохраняется." TextWrapping="Wrap"/>
          <TextBlock Text="Эта версия не является системной службой. Диспетчер задач, удаление файлов, отключение автозапуска средствами Windows или права администратора позволяют обойти защиту. Программа не скрывает себя и не блокирует системные инструменты." TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Браузер" Padding="10,9"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,14,0">
        <local:HelpLabel Label="Подключение Chrome или Edge" Help="Без расширения видно общее время браузера. С расширением — время на доменах и воспроизведение YouTube. Переписка, поисковые запросы и названия роликов не сохраняются."/>
        <TextBlock Text="1. Откройте chrome://extensions или edge://extensions.&#10;2. Включите режим разработчика.&#10;3. Нажмите «Загрузить распакованное расширение».&#10;4. Выберите папку extension из установленной программы.&#10;5. Откройте обычную вкладку и проверьте состояние ниже." TextWrapping="Wrap" LineHeight="27" Margin="0,12,0,16"/>
        <WrapPanel><Button Content="Открыть папку расширения" Click="ExtensionFolderClick" Style="{StaticResource Primary}"/><Button Content="Скопировать путь" Click="ExtensionPathClick"/><local:HelpTip Text="Первая кнопка открывает папку в Проводнике. Вторая копирует её полный адрес: вставьте его в окно выбора папки при установке расширения."/></WrapPanel>
        <TextBlock x:Name="ExtensionStatus" FontWeight="SemiBold" Margin="0,18,0,16" TextWrapping="Wrap"/>
        <WrapPanel><Button Content="Восстановить связь с браузером" Click="RegisterClick"/><local:HelpTip Text="Заново регистрирует локальный канал между приложением и расширением. Используйте, если после установки расширения связи нет. Затем перезагрузите расширение на странице браузера."/></WrapPanel>
        <TextBlock Text="Один обычный профиль Chrome и один Edge. Режим инкогнито и другие браузеры пока без детализации." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,22,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Telegram" Padding="10,9"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,14,0">
        <local:HelpLabel Label="Бот вашей семьи" Help="Создайте отдельного бота для этого компьютера. Родитель получает отчёты и нажимает «Отчёт за сегодня» или «Сколько осталось». Пока компьютер выключен или без интернета, немедленного ответа не будет."/>
        <TextBlock Text="1. Откройте официальный @BotFather.&#10;2. Отправьте /newbot и создайте бота.&#10;3. Скопируйте выданный токен в поле ниже.&#10;4. Нажмите «Проверить токен», затем откройте ссылку на телефоне родителя и нажмите START." TextWrapping="Wrap" LineHeight="25" Margin="0,10,0,14"/>
        <Button Content="Открыть BotFather" Click="BotFatherClick" HorizontalAlignment="Left"/>
        <local:HelpLabel Label="Токен бота" Help="Это секретный ключ от @BotFather, а не имя бота и не пароль Telegram. Никому его не отправляйте. Здесь он хранится зашифрованным для текущей учётной записи Windows."/>
        <PasswordBox x:Name="TokenBox" MaxLength="200"/>
        <WrapPanel Margin="0,12,0,8"><Button x:Name="ConnectButton" Content="Проверить токен и привязать родителя" Click="ConnectClick" Style="{StaticResource Primary}"/><Button Content="Отключить" Click="DisconnectClick"/><local:HelpTip Text="Проверка создаёт ссылку привязки на 10 минут. Отключение отменяет ожидающие сообщения, но не удаляет историю. Один токен используйте только на одном компьютере."/></WrapPanel>
        <Border x:Name="PairPanel" Background="#EAF0FC" Padding="16" CornerRadius="10" Margin="0,12" Visibility="Collapsed"><StackPanel>
          <TextBlock Text="Откройте ссылку на телефоне родителя и нажмите START. Не передавайте её ребёнку или посторонним." TextWrapping="Wrap"/>
          <TextBox x:Name="PairLink" IsReadOnly="True" Margin="0,12"/>
          <StackPanel Orientation="Horizontal"><Button Content="Скопировать ссылку" Click="CopyPairClick"/><Button Content="Открыть бота" Click="OpenPairClick"/></StackPanel>
        </StackPanel></Border>
        <TextBlock x:Name="TelegramStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12"/>
        <WrapPanel><Button Content="Отправить пробный отчёт" Click="TestTelegramClick"/><local:HelpTip Text="После привязки отправляет текущую сводку родителю. Подождите несколько секунд и откройте чат с вашим ботом."/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Отчёты и данные" Padding="10,9"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,14,0">
        <local:HelpLabel Label="Автоматические отчёты" Help="Работают после привязки Telegram. Без интернета сообщения ждут в очереди. Если компьютер выключен, отправка происходит после следующего запуска."/>
        <StackPanel Orientation="Horizontal"><CheckBox x:Name="ShutdownReportBox" Content="Отчёт перед выключением компьютера"/><local:HelpTip Text="Перед штатным выключением, перезагрузкой или выходом из Windows отправляет итог за сегодня. Сначала подключите Telegram. Отчёт останется в чате, когда компьютер выключен. При сбое отправки он сохранится до следующего запуска. Сон и закрытие окна не вызывают этот отчёт."/></StackPanel>
        <TextBlock Text="Отправка — в начале завершения работы Windows. При потере питания или интернета доставить отчёт до отключения не получится." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal"><CheckBox x:Name="SessionReportBox" Content="После завершения сеанса"/><local:HelpTip Text="Сводка после перерыва, указанного в поле «Конец сеанса». Несколько сеансов расходуют один общий дневной лимит."/></StackPanel>
        <StackPanel Orientation="Horizontal"><CheckBox x:Name="DailyReportBox" Content="Итог завершённого дня"/><local:HelpTip Text="Полная сводка за вчера. После полуночи или при следующем запуске. Включает поздние игры после вечернего отчёта."/></StackPanel>
        <StackPanel Orientation="Horizontal"><CheckBox x:Name="WeeklyReportBox" Content="Итог завершённой недели"/><local:HelpTip Text="Отчёт за прошедшие понедельник–воскресенье. Отправляется, когда компьютер работает после окончания недели."/></StackPanel>
        <StackPanel Orientation="Horizontal"><CheckBox x:Name="EveningReportBox" Content="Вечерний срез текущего дня"/><local:HelpTip Text="Промежуточная сводка после выбранного часа. Использование компьютера после отчёта продолжает учитываться."/></StackPanel>
        <local:HelpLabel Label="Час вечернего отчёта (0–23)" Help="21 означает после 21:00 в часовом поясе учёта. Если компьютер включится позже, отчёт будет отправлен тогда."/>
        <TextBox x:Name="EveningHourBox" Width="85" HorizontalAlignment="Left"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><local:HelpLabel Label="Подробная история, дней" Help="Сколько дней хранить интервалы использования программ и сайтов. От 7 до 365. Более старые подробности удаляются автоматически."/><TextBox x:Name="HistoryDaysBox"/></StackPanel>
          <StackPanel Grid.Column="2"><local:HelpLabel Label="Дневные итоги, дней" Help="Срок хранения суммарной статистики: до 730 дней, не меньше подробной истории. Например, 365 — итоги за год."/><TextBox x:Name="SummaryDaysBox"/></StackPanel>
        </Grid>
        <TextBlock x:Name="QueueStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,20,0,12"/>
        <WrapPanel><Button Content="Повторить отправку ошибок" Click="RetryClick"/><Button Content="Папка данных" Click="DataFolderClick"/><local:HelpTip Text="Повтор нужен после устранения проблемы с ботом. Папка содержит базу и журнал ошибок. Не удаляйте и не пересылайте базу: там личная история и настройки семьи."/></WrapPanel>
        <WrapPanel Margin="0,18,0,0"><Button Content="Удалить историю…" Click="ClearClick" Foreground="#B42318"/><local:HelpTip Text="Безвозвратно удаляет историю и очередь, обнуляет сегодняшний расход лимита. Пароль и привязка родителя сохраняются. Появится отдельное подтверждение."/></WrapPanel>
        <Button x:Name="DonateButton" Content="Поддержать разработку" Click="DonateClick" HorizontalAlignment="Left" Margin="0,20,0,12" Visibility="Collapsed"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <local:HelpTip Text="«Сохранить» применяет настройки и оставляет окно открытым. «Закрыть» закрывает только настройки, не останавливая учёт. Несохранённые изменения полей не применяются."/>
        <Button Content="Закрыть настройки" Click="CloseClick" Margin="12,0,8,0"/>
        <Button x:Name="SaveButton" Content="Сохранить" Click="SaveClick" Style="{StaticResource Primary}" Margin="0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
